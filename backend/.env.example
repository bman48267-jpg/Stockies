# Stockies Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Application ───────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Database ──────────────────────────────────────────
DATABASE_URL=sqlite:///./stockies.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/stockies

# ─── CORS ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Stock Data Providers ──────────────────────────────
STOCK_DATA_PROVIDER=yfinance
# STOCK_API_KEY=your-api-key-here

# ─── Mutual Fund Providers ─────────────────────────────
MF_DATA_PROVIDER=mfapi
# MF_API_KEY=your-api-key-here

# ─── Cache ─────────────────────────────────────────────
CACHE_QUOTE_TTL_SECONDS=300
CACHE_FUNDAMENTALS_TTL_SECONDS=3600
CACHE_HISTORY_TTL_SECONDS=86400
CACHE_NAV_TTL_SECONDS=86400
